# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8086
TZ=UTC
BASEROW_PUBLIC_URL=http://127.0.0.1:8086
BASEROW_FRONTEND_COOKIE_PREFIX=baserow_

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 24
DATABASE_PASSWORD=

# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# Generate: openssl rand -hex 32
SECRET_KEY=

# Generate: openssl rand -hex 32
BASEROW_JWT_SIGNING_KEY=

# Container account ids used by prepare.
POSTGRES_UID=70
POSTGRES_GID=70
REDIS_UID=65532
REDIS_GID=65532

# This recipe uses DHI images for available components.
# Baserow retain upstream image pins because this recipe has no DHI equivalents.

# First startup downloads and verifies the pinned Gunicorn wheel from PyPI.
# It is cached in python-overrides and mounted read-only by the application.
