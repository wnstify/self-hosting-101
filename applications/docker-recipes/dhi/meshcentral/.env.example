# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=4430
TZ=UTC
ADMIN_EMAIL=admin@example.com
# Set these to the public hostname and port when you put an HTTPS proxy in front.
MESH_HOST=127.0.0.1
MESH_ALIAS_PORT=4430
# Agents download their server certificate from this URL. Use null for plain HTTP, otherwise '"https://mesh.example.com"'.
MESH_CERT_URL_JSON=null

# Generate: openssl rand -hex 24
MONGO_ROOT_PASSWORD=
# Generate: openssl rand -hex 24
MONGO_PASSWORD=
# MeshCentral rejects weak passwords. Generate: printf '%sA1!\n' "$(openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_')"
ADMIN_PASSWORD=
# Generate: openssl rand -hex 32
SESSION_KEY=

# This recipe uses DHI images for available components.
# MeshCentral retains its upstream image pin because this recipe has no DHI equivalent.

# prepare copies its pinned BusyBox into runtime-checks for MongoDB TCP health probes.
# The DHI probe also copies the matching musl loader; MongoDB mounts both read-only.
