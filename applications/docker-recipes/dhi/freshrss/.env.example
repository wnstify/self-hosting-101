# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8088
TZ=UTC
# The FreshRSS setup wizard asks for this URL; the image never reads it.
BASE_URL=http://127.0.0.1:${PORT}
CRON_MIN=3,33

# Image defaults below are pinned in compose.yaml.
# FRESHRSS_IMAGE=freshrss/freshrss:1.29.1-alpine@sha256:e1c956e586ae20ba7f9a0c6582043172ee084af43f17ff48b8de22ade026b6c4
# PREPARE_IMAGE=busybox:1.37.0-musl@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23

# DHI fallback: this stack retains its pinned upstream images. It contains no dhi.io images.
