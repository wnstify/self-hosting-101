# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8093
TZ=UTC
SITE_URL=http://127.0.0.1:8093
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Defaults to ./data; set the absolute path when running compose from another directory or when the data directory lives elsewhere.
# HOST_DATA_DIR=/absolute/path/to/dockhand/data
# Defaults to the rootless socket in XDG_RUNTIME_DIR; set it when the socket lives elsewhere.
# DOCKER_SOCKET=/run/user/<uid>/docker.sock

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 24
DATABASE_PASSWORD=

# Generate: openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_'
ADMIN_PASSWORD=

# Generate: openssl rand -base64 32 | tr -d '\n'
ENCRYPTION_KEY=

# PostgreSQL account ids.
POSTGRES_UID=70
POSTGRES_GID=70

# This recipe uses DHI images for available components.
# Dockhand and the Docker socket proxy retain upstream image pins because this recipe has no DHI equivalents.
