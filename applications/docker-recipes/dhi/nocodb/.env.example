# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8090
TZ=UTC
SITE_URL=http://127.0.0.1:${PORT}
ADMIN_EMAIL=admin@example.com

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 24
NC_DB_PASSWORD=

# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# Generate: openssl rand -hex 32
NC_AUTH_JWT_SECRET=

# Generate: openssl rand -hex 32
NC_CONNECTION_ENCRYPT_KEY=

# NocoDB rejects an administrator password without a letter, a digit and a symbol.
# Generate: printf '%sA1!\n' "$(openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_')"
NC_ADMIN_PASSWORD=

POSTGRES_UID=70
POSTGRES_GID=70
REDIS_UID=65532
REDIS_GID=65532

# The administrator account is created before the worker starts, so up --wait sees the job finish.

# This recipe uses DHI images for its dependencies and prepare. The application images stay upstream because no DHI equivalent exists.
