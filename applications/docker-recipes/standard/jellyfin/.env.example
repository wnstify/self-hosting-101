# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env. This recipe has no secrets; the setup wizard creates the administrator.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8096
TZ=UTC

# After prepare, copy your libraries into media/, movies/ and shows/ inside this deployment directory.
# prepare gives those directories to the owner of this directory, so copy as that user.
# Jellyfin runs as UID 1000 and mounts them read-only; make the files readable: chmod -R o+rX media movies shows
# Add the libraries in the setup wizard as /data/media, /data/movies and /data/shows.
