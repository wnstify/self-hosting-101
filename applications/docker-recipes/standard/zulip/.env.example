# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8080
TZ=UTC
# Zulip builds its links from SITE_URL, so it must be the URL your reverse proxy serves.
SITE_URL=https://zulip.example.com
# Required when SITE_URL has no real domain, for example zulip.test; Zulip uses it for synthetic bot addresses.
FAKE_EMAIL_DOMAIN=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ORGANIZATION_NAME='My organization'
SMTP_MODE=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=admin@example.com
SMTP_FROM=admin@example.com
# Set the password supplied by the SMTP provider when SMTP_MODE=smtp.
SMTP_PASSWORD=

POSTGRES_UID=70
POSTGRES_GID=70
REDIS_UID=999
REDIS_GID=1000
RABBITMQ_UID=999
RABBITMQ_GID=999

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 24
ZULIP_DB_PASSWORD=

# Generate: openssl rand -hex 24
MEMCACHED_PASSWORD=

# Generate: openssl rand -hex 24
RABBITMQ_PASSWORD=

# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# Generate: openssl rand -hex 32
ZULIP_SECRET_KEY=

# Generate: openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_'
ADMIN_PASSWORD=

# First startup downloads a checksum-pinned dictionary package from deb.debian.org and a Pika wheel from pypi.org.
# Dictionaries and licenses persist in dictionaries/; the Pika wheel stays in python-overrides/.
# Remove the Pika override after the app image includes Pika >= 1.4.1 and passes shutdown tests.

# The app container is capped at 3 GB RAM for its separate queue worker processes, and the pinned app image is 4.18 GB.
