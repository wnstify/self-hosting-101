# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=9000
TZ=UTC
SITE_URL=http://127.0.0.1:9000
ADMIN_EMAIL=admin@example.com

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 24
AUTHENTIK_DB_PASSWORD=

# Generate: openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'
AUTHENTIK_SECRET_KEY=

# Generate: openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_'
AUTHENTIK_ADMIN_PASSWORD=

# Generate: openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_TOKEN=

# Derive from AUTHENTIK_ADMIN_PASSWORD after exporting it:
# printf '%s' "$AUTHENTIK_ADMIN_PASSWORD" | python3 -c 'import base64,hashlib,secrets,sys; s=secrets.token_hex(16); d=hashlib.pbkdf2_hmac("sha256",sys.stdin.buffer.read(),s.encode(),1000000); print("$".join(["pbkdf2_sha256","1000000",s,base64.b64encode(d).decode()]))'
# Single quotes keep the dollar signs in the hash from being read as variables.
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH=''

# PostgreSQL data directory owner.
POSTGRES_UID=70
POSTGRES_GID=70

# Image defaults below are pinned in compose.yaml.
# POSTGRES_IMAGE=postgres:18.6-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
# SERVER_IMAGE=ghcr.io/goauthentik/server:2026.8.1@sha256:9d605ed569ff9f39146be39da93714b2acf19072acc4ab0f0e2f2d81be88cdce
# PREPARE_IMAGE=busybox:1.37.0-musl@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23
