# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
# source-patch applies a checksum-checked Mira 0.4.0 shutdown fix.
# Review or remove that patch before changing MIRA_IMAGE.
PORT=8000
TZ=UTC
# Mira refuses to start until the next two are set, so create a GitHub App first.
# App ID from the app's settings page.
MIRA_GITHUB_APP_ID=
# One-line base64 of the app's private key: base64 < github-app.pem | tr -d '\n'
MIRA_GITHUB_PRIVATE_KEY_BASE64=
# The GitHub App slug, optional: setting it skips a lookup during startup.
MIRA_BOT_NAME=
# Change only for GitHub Enterprise, for example https://github.example.com/api/v3
MIRA_GITHUB_API_URL=https://api.github.com
# Funded key from https://openrouter.ai/settings/keys; the stack starts without it, but reviews and indexing fail.
OPENROUTER_API_KEY=
MIRA_MODEL=anthropic/claude-sonnet-4-6
MIRA_INDEXING_MODEL=anthropic/claude-haiku-4-5

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 24
MIRA_DB_PASSWORD=
# Sign in as admin with this password. Generate with: openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_'
ADMIN_PASSWORD=
# Also set as the GitHub App webhook secret. Generate with: openssl rand -hex 32
MIRA_WEBHOOK_SECRET=
