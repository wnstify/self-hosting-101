# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8880
TZ=UTC
BASE_URL=http://127.0.0.1:8880
# Match BASE_URL with http changed to ws or https changed to wss.
WS_URL=ws://127.0.0.1:8880
VOICE_IP=127.0.0.1
VOICE_TCP_PORT=7881
VOICE_UDP_START=50000
VOICE_UDP_END=50100
REDIS_UID=999
REDIS_GID=1000
RABBITMQ_UID=100
RABBITMQ_GID=101
CADDY_UID=0
CADDY_GID=0
CADDY_ENTRYPOINT=/usr/bin/caddy

# Generate: openssl rand -hex 32
MONGO_ROOT_PASSWORD=

# Generate: openssl rand -hex 32
MONGO_PASSWORD=

# Generate: openssl rand -hex 32
REDIS_PASSWORD=

# Generate: openssl rand -hex 32
RABBIT_PASSWORD=

# Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Generate: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=

# Generate: openssl rand -hex 32
GARAGE_METRICS_TOKEN=

# Generate: openssl rand -hex 32
S3_SECRET_KEY=

# Generate: openssl rand -hex 32
LIVEKIT_SECRET=

# Generate: openssl rand -base64 512 | tr -d '\n'
MONGO_KEY=

# Generate: printf 'GK%s\n' "$(openssl rand -hex 12)"
S3_ACCESS_KEY=

# Generate: openssl rand -hex 6
LIVEKIT_KEY=

# Generate: openssl rand -base64 32 | tr -d '\n'
FILES_ENCRYPTION_KEY=

# Generate one shared key first: pem=$(openssl ecparam -name prime256v1 -genkey -noout)
# Generate: printf '%s\n' "$pem" | base64 -w0 | tr -d '='
VAPID_PRIVATE_KEY=
# Generate from the same pem: printf '%s\n' "$pem" | openssl ec -pubout -outform DER 2>/dev/null | tail -c 65 | base64 -w0 | tr '+/' '-_' | tr -d '='
VAPID_PUBLIC_KEY=
