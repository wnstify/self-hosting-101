# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8081
TZ=UTC
ADMIN_USER=admin
# These defaults suit a local test. For a real deployment set SITE_HOST to your hostname and SITE_PROTOCOL to https,
# and terminate TLS in a reverse proxy. Keep SITE_HOST and SITE_PROTOCOL consistent with SITE_URL.
SITE_HOST=127.0.0.1:${PORT}
SITE_PROTOCOL=http
SITE_URL=${SITE_PROTOCOL}://${SITE_HOST}

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 24
NEXTCLOUD_DB_PASSWORD=

# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# Sign in as ADMIN_USER with this password. Generate: openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_'
NEXTCLOUD_ADMIN_PASSWORD=

# Uncomment to pin a different Nextcloud release.
# NEXTCLOUD_IMAGE=nextcloud:34.0.3-fpm-alpine@sha256:a953332f3e98441f268b5b85d298d285f66ea6054fa3988e22a127f291de26f5
# Owners of the bind-mounted data directories; prepare applies them. Change them only together with the matching image.
# The nginx default is the unprivileged build; the official image needs root to run its entrypoint and to write into /etc/nginx.
POSTGRES_UID=70
POSTGRES_GID=70
REDIS_UID=999
REDIS_GID=1000
NGINX_UID=101
NGINX_GID=101
