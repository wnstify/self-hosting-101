# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=51821
TZ=UTC
# Replace with the public hostname or IP address VPN clients reach; generated client configs embed it.
WG_HOST=vpn.example.com
# Published on all interfaces as UDP by design; open it in the host firewall.
# The container gets NET_ADMIN and enables IPv4 forwarding.
WG_PORT=51820
ADGUARD_PORT=3000
# Applied on first setup only. Change the upstream later in the AdGuard UI.
ADGUARD_UPSTREAM_DNS=https://cloudflare-dns.com/dns-query
# Keep both /24 subnets distinct and outside existing host routes and Docker networks. Check with: ip route
DOCKER_SUBNET=10.180.10.0/24
WG_SUBNET=10.200.10.0/24
WG_IPV6_SUBNET=fd42:180:10::/64
# Update these addresses together when DOCKER_SUBNET changes.
DOCKER_GATEWAY=10.180.10.1
WG_ADDRESS=10.180.10.2
ADGUARD_ADDRESS=10.180.10.100

# Generate: openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
WG_EASY_PASSWORD=

# Generate: openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
ADGUARD_PASSWORD=
