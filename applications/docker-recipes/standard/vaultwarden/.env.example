# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8080
TZ=UTC
# Replace with the hostname your reverse proxy serves. Vaultwarden bakes it into links and WebAuthn origins;
# the container itself listens on 127.0.0.1:PORT without TLS, so a reverse proxy is required.
VAULTWARDEN_DOMAIN=vaultwarden.example.com
# Vaultwarden builds its links and WebAuthn origin from DOMAIN, so it must match the URL the browser uses.
DOMAIN=https://${VAULTWARDEN_DOMAIN}
POSTGRES_UID=70
POSTGRES_GID=70

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 24
VAULTWARDEN_DB_PASSWORD=

# ADMIN_PASSWORD is only the input for ADMIN_TOKEN below; the stack reads the token.
# Generate: openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
ADMIN_PASSWORD=

# Needs the argon2 package (apt install argon2). Export ADMIN_PASSWORD in the same shell first, then run:
# printf '%s' "$ADMIN_PASSWORD" | argon2 "$(openssl rand -base64 32)" -id -k 65540 -t 3 -p 4 -e
# Keep the Argon2 hash in single quotes to preserve its dollar signs.
ADMIN_TOKEN=''
