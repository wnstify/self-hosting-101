# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=5678
TZ=UTC
SITE_URL=http://127.0.0.1:5678/
# Match SITE_URL. Behind an HTTPS proxy set https, true and the number of proxy hops.
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
PROXY_HOPS=0

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 24
N8N_DB_PASSWORD=
# Losing this key makes every stored credential unreadable. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=
