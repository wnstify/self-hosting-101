# Run every command below from this deployment directory, after copying the recipe out of the repository.
# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=8025
TZ=UTC
# BASE_URL and APPFLOWY_WEBSOCKET_BASE_URL must point at the same host and port; change them together.
BASE_URL=http://127.0.0.1:${PORT}
APPFLOWY_WEBSOCKET_BASE_URL=ws://127.0.0.1:${PORT}/ws/v2
GOTRUE_ADMIN_EMAIL=admin@example.com
# SMTP and OAuth settings go in extra.env, which prepare creates empty.

# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 32
REDIS_PASSWORD=

# Generate: openssl rand -hex 32
MINIO_ROOT_PASSWORD=

# Generate: openssl rand -hex 32
GOTRUE_JWT_SECRET=

# Generate: openssl rand -hex 32
GOTRUE_ADMIN_PASSWORD=

# Container account ids used by prepare.
POSTGRES_UID=999
POSTGRES_GID=999
REDIS_UID=999
REDIS_GID=1000
NGINX_UID=101
NGINX_GID=101
