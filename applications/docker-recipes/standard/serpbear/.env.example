# 1. Copy this file to .env and fill in every empty secret.
# 2. Run: docker compose run --rm prepare
#    It creates the data directories, sets their ownership, and writes config files.
#    Stop the stack before rerunning it after editing .env.
# 3. Run: docker compose up -d --wait
PORT=3009
TZ=UTC
SITE_URL=http://127.0.0.1:${PORT}
SERPBEAR_USER=admin

# Generate with: openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
SERPBEAR_PASSWORD=

# Generate with: openssl rand -hex 32
SERPBEAR_SECRET=

# Generate with: openssl rand -hex 32
SERPBEAR_APIKEY=

# Keyword tracking stays idle until a scraper and its credentials are set in Settings.
