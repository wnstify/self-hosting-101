# Rescue only. Copy to /tmp/proxmox-auto/install.env and replace every placeholder.
# Disk paths name whole PHYSICAL disks by stable ID. Check both serials against lsblk in Rescue first.
WORK_DIR=/tmp/proxmox-auto
# Mandatory for Rescue, the QEMU guest, and the physical Proxmox host.
FIRMWARE_MODE=bios
TARGET_DISK_1=/dev/disk/by-id/REPLACE_WITH_DISK_1_ID
EXPECTED_SERIAL_1=REPLACE_WITH_DISK_1_SERIAL
TARGET_DISK_2=/dev/disk/by-id/REPLACE_WITH_DISK_2_ID
EXPECTED_SERIAL_2=REPLACE_WITH_DISK_2_SERIAL
# Lowercase, with colons. The builder checks it against the answer's MAC filter and nic0 mapping.
NIC_MAC=REPLACE_WITH_NIC_MAC
# Must match answer.toml. Used to boot the installed disks for verification.
GUEST_CIDR=192.0.2.10/24
GUEST_GATEWAY=192.0.2.1
# Do not add CHECK_ONLY or ERASE_CONFIRMED here. Pass them on the command line of the approved run only.
