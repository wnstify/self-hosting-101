# Installer payloads contain credentials, including password hashes.
answer.toml
install.env
*.iso
*.qcow2
*.log
*.sock
*.pem
*.key
proxmox-initial-password*
.private/
__pycache__/

# Deployment-specific evidence and captured host keys stay local.
records/
installed-known-hosts
*.ppm

# Local agent configuration stays out of the repository. The committed skill
# pointer is the exception; Claude Code needs it to find the shared skill.
.claude/*
!.claude/skills/
.codex/
