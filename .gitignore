# Installer payloads contain credentials, including password hashes.
answer.toml
install.env
*.iso
*.qcow2
*.log
*.sock
*.pem
*.key
proxmox-initial-password*
.private/
__pycache__/

# Deployment-specific evidence and captured host keys stay local.
records/
installed-known-hosts
*.ppm

# Local tool and agent folders stay out of the repository. Only .github is
# tracked. Agents get skills from skills/ at the repository root.
.*/
!.github/
